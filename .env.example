# Must match the Node backend's AI_SERVICE_TOKEN (backend/.env.example).
AI_SERVICE_TOKEN=

# Public half of the RS256 keypair Node signs with. NEVER the private key —
# see docs/VETRA_AI_ARCHITECTURE.md §6 (a shared secret would let a
# compromised ai-service forge tokens; this asymmetric scheme can't).
AI_SERVICE_JWT_PUBLIC_KEY=

# Node's internal API, reachable only from ai-service's network.
NODE_INTERNAL_URL=http://localhost:5000

OPENAI_API_KEY=
